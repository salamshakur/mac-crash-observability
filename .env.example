# Copy to .env with:  scripts/setup_env.sh   (it fills in the blanks for you)
# .env is gitignored. Never commit it: the first block identifies your Mac.

# --- Machine identifiers ---------------------------------------------------
# Used ONLY to scrub these values out of data/index.ndjson before it can be published.
MAC_SERIAL=
MAC_HW_UUID=
MAC_USERNAME=
MAC_COMPUTER_NAME=
MAC_LOCAL_HOSTNAME=
MAC_HOSTNAME=

# --- Non-identifying context -----------------------------------------------
MAC_MODEL=
# IANA zone, e.g. America/New_York. Report file names use local time.
MAC_TIMEZONE=

# Name for this Mac in Loki/Grafana (shown instead of the real hostname).
HOST_LABEL=my-mac

# --- Shipping to Loki ------------------------------------------------------
# Loki's HTTP address on your Mac mini / Raspberry Pi, e.g. http://raspberrypi.local:3100
# Leave empty until the stack is running; scheduled runs push only when this is set.
LOKI_URL=
# Only needed if you put Loki behind a reverse proxy with basic auth.
LOKI_USERNAME=
LOKI_PASSWORD=
