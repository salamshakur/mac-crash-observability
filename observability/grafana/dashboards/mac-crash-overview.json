{
  "uid": "mac-crash-overview",
  "title": "Mac crash overview",
  "tags": [
    "macos",
    "crash",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "Kernel panics, app crashes and storage-integrity errors from data/index.ndjson, plus timing and fault-address evidence",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Mac",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({job=\"mac-crash\"}, host)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Kernel panics",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"kernel_panic\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Whole-system crashes. Counts category=kernel_panic only (the T2 copies are excluded).",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "App crashes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Individual processes that crashed.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "APFS hash mismatches",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"apfs_hash_mismatch\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Kernel log: data read from the sealed system volume didn't match Apple's hash.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Storage-read crashes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | fs_pagein_error=\"true\" or codesign_invalid=\"true\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "App crashes caused by 'FS pagein error' (Bad message) or 'Code Signature Invalid' on a page of code.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Events over time by category",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (category) (count_over_time({job=\"mac-crash\", host=~\"$host\"}[$__interval]))",
          "queryType": "range",
          "legendFormat": "{{category}}"
        }
      ],
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Top crashing processes",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (process) (count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{process}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Crash signals",
      "type": "piechart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (signal) (count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | signal!=\"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{signal}}"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Kernel panics",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"mac-crash\", host=~\"$host\", category=\"kernel_panic\"} | json | line_format \"{{.panic_subsystem}}  \u00b7  {{.process}}  \u00b7  uptime {{.uptime_s}}s  \u00b7  {{.panic_reason_normalized}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 9,
      "title": "Faulting code (app crashes)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (process, signal, top_frame) (count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "All events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"mac-crash\", host=~\"$host\"} | json | line_format \"{{.category}}  \u00b7  {{.process}}  \u00b7  {{or .signal .panic_subsystem .resource .volume \\\"\\\"}}  \u00b7  {{or .subtype .panic_reason_normalized .detail \\\"\\\"}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Timing and fault evidence",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "App crashes per boot session",
      "type": "table",
      "description": "One row per boot session (boot_id is a hash of the session identifier). count = app-crash reports; uptime at first report = the lowest uptime_s among them. macOS prints uptime coarsely (e.g. 12000). Reports exist only from when collection began.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (boot_id) (count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | boot_id != \"\" [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "min by (boot_id) (min_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | boot_id != \"\" | unwrap uptime_s | __error__=\"\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "count",
              "Value #B": "uptime at first report"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "uptime at first report"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 13,
      "title": "Boot sessions, boots and kernel panics over time",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "App-crash reports per boot_id (a new boot_id starting means a new boot session), boots as printed by pmset (powerd started), and kernel panics.",
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (boot_id) (count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | boot_id != \"\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "app crashes \u00b7 boot {{boot_id}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"kernel_panic\"}[$__interval]))",
          "queryType": "range",
          "legendFormat": "kernel panics"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"boot\"}[$__interval]))",
          "queryType": "range",
          "legendFormat": "boot (powerd started)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1
          },
          "noValue": "0",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "kernel panics"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "boot (powerd started)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Seconds since wake at crash (app crashes)",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "app_crash reports by since_wake_s (the wakeTime field of the report). 'not in report' = the report has no wakeTime (for example right after a boot).",
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | since_wake_s != \"\" | since_wake_s < 60 [$__range]))",
          "queryType": "instant",
          "legendFormat": "under 1 min"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | since_wake_s != \"\" | since_wake_s >= 60 and since_wake_s < 300 [$__range]))",
          "queryType": "instant",
          "legendFormat": "1 to 5 min"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | since_wake_s != \"\" | since_wake_s >= 300 and since_wake_s < 900 [$__range]))",
          "queryType": "instant",
          "legendFormat": "5 to 15 min"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | since_wake_s != \"\" | since_wake_s >= 900 and since_wake_s < 3600 [$__range]))",
          "queryType": "instant",
          "legendFormat": "15 to 60 min"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | since_wake_s != \"\" | since_wake_s >= 3600 [$__range]))",
          "queryType": "instant",
          "legendFormat": "1 hour or more"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | since_wake_s = \"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "not in report"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "App crashes per wake",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "app_crash reports divided by wake events in the selected range. Wake events come from pmset -g log, which macOS keeps for about a week, so they exist only from the first capture; crashes from before that are counted without matching wakes.",
      "gridPos": {
        "x": 10,
        "y": 57,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"}[$__range])) / sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"power_event\"} | json | power_event=\"wake\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "per full wake"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"}[$__range])) / sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"power_event\"} | json | power_event=~\"wake|darkwake\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "per wake or darkwake"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "App crashes and wakes over time",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Per interval: app_crash reports, full wakes and darkwakes (from pmset -g log).",
      "gridPos": {
        "x": 14,
        "y": 57,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
