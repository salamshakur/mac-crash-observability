{
  "uid": "mac-crash-overview",
  "title": "Mac crash overview",
  "tags": [
    "macos",
    "crash",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "Kernel panics, app crashes and storage-integrity errors from data/index.ndjson",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Mac",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({job=\"mac-crash\"}, host)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Kernel panics",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"kernel_panic\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Whole-system crashes. Counts category=kernel_panic only (the T2 copies are excluded).",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "App crashes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Individual processes that crashed.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "APFS hash mismatches",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"apfs_hash_mismatch\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Kernel log: data read from the sealed system volume didn't match Apple's hash.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Storage-read crashes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | fs_pagein_error=\"true\" or codesign_invalid=\"true\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "App crashes caused by 'FS pagein error' (Bad message) or 'Code Signature Invalid' on a page of code.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Events over time by category",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (category) (count_over_time({job=\"mac-crash\", host=~\"$host\"}[$__interval]))",
          "queryType": "range",
          "legendFormat": "{{category}}"
        }
      ],
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Top crashing processes",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (process) (count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{process}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Crash signals",
      "type": "piechart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (signal) (count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json | signal!=\"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{signal}}"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Kernel panics",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"mac-crash\", host=~\"$host\", category=\"kernel_panic\"} | json | line_format \"{{.panic_subsystem}}  \u00b7  {{.process}}  \u00b7  uptime {{.uptime_s}}s  \u00b7  {{.panic_reason_normalized}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 9,
      "title": "Faulting code (app crashes)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (process, signal, top_frame) (count_over_time({job=\"mac-crash\", host=~\"$host\", category=\"app_crash\"} | json [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "All events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"mac-crash\", host=~\"$host\"} | json | line_format \"{{.category}}  \u00b7  {{.process}}  \u00b7  {{or .signal .panic_subsystem .resource .volume \\\"\\\"}}  \u00b7  {{or .subtype .panic_reason_normalized .detail \\\"\\\"}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}